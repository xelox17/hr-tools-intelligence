{
  "name": "Kelio Daily Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "a1e6f1b0-1c2d-4a3e-9f10-keliosync001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/sync/kelio",
        "options": {
          "timeout": 60000
        }
      },
      "id": "b2f7a2c1-2d3e-4b4f-8021-keliosync002",
      "name": "Sync Kelio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log('✅ Kelio sync result:', JSON.stringify($input.all().map(i => i.json), null, 2));\nreturn $input.all();"
      },
      "id": "c3a8b3d2-3e4f-4c50-9132-keliosync003",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Sync Kelio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync Kelio": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris"
  },
  "pinData": {}
}
